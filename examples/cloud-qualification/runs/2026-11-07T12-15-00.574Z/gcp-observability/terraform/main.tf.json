{
  "terraform": {
    "required_version": ">= 1.5.0, < 2.0.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 6.0"
      }
    }
  },
  "variable": {
    "aws_region": {
      "type": "string",
      "description": "Explicitly choose the reviewed deployment region; no region is assumed."
    },
    "aws_account_id": {
      "type": "string",
      "description": "Expected AWS account ID; provider refuses a different account.",
      "validation": {
        "condition": "${can(regex(\"^[0-9]{12}$\", var.aws_account_id))}",
        "error_message": "Use a twelve digit AWS account ID."
      }
    },
    "review_approved": {
      "type": "bool",
      "default": false,
      "description": "Set only after reviewing the design, cost, security and generated Terraform."
    }
  },
  "provider": {
    "aws": {
      "region": "${var.aws_region}",
      "allowed_account_ids": [
        "${var.aws_account_id}"
      ]
    }
  },
  "locals": {
    "unfinished_work": [
      "resource-block_7365727669636573",
      "resource-block_6c6f6767696e67",
      "resource-block_7472616365",
      "resource-block_707562737562",
      "resource-block_726564616374",
      "resource-block_6271",
      "resource-block_616e616c79736973",
      "resource-block_67656d696e69",
      "resource-block_6f70657261746f72",
      "connection-652d7376632d6c6f67",
      "connection-652d7376632d7472616365",
      "connection-652d6c6f672d7073",
      "connection-652d74726163652d7073",
      "connection-652d70732d726564616374",
      "connection-652d7265646163742d6271",
      "connection-652d62712d616e616c79736973",
      "connection-652d616e616c797369732d67656d696e69",
      "connection-652d6f702d616e616c79736973",
      "connection-652d616e616c797369732d6f70"
    ]
  },
  "resource": {
    "terraform_data": {
      "review_gate": {
        "input": {
          "design_revision": 2,
          "environment": "staging"
        },
        "lifecycle": {
          "precondition": [
            {
              "condition": "${var.review_approved && length(local.unfinished_work) == 0}",
              "error_message": "Review this sketch and finish the work listed in resource-schedule.json before a deployment plan can succeed."
            }
          ]
        }
      }
    }
  },
  "output": {
    "design_revision": {
      "value": 2
    },
    "environment": {
      "value": "staging"
    },
    "implemented_foundations": {
      "value": 0
    },
    "buckets": {
      "value": {}
    }
  }
}
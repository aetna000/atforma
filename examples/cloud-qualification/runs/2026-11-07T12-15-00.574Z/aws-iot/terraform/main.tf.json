{
  "terraform": {
    "required_version": ">= 1.5.0, < 2.0.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 6.0"
      }
    }
  },
  "variable": {
    "aws_region": {
      "type": "string",
      "description": "Explicitly choose the reviewed deployment region; no region is assumed."
    },
    "aws_account_id": {
      "type": "string",
      "description": "Expected AWS account ID; provider refuses a different account.",
      "validation": {
        "condition": "${can(regex(\"^[0-9]{12}$\", var.aws_account_id))}",
        "error_message": "Use a twelve digit AWS account ID."
      }
    },
    "review_approved": {
      "type": "bool",
      "default": false,
      "description": "Set only after reviewing the design, cost, security and generated Terraform."
    }
  },
  "provider": {
    "aws": {
      "region": "${var.aws_region}",
      "allowed_account_ids": [
        "${var.aws_account_id}"
      ]
    }
  },
  "locals": {
    "unfinished_work": [
      "resource-block_64657669636573",
      "resource-block_696f74",
      "resource-block_627566666572",
      "resource-block_73636f726572",
      "resource-block_71756172616e74696e65",
      "resource-block_6d6f64656c",
      "resource-block_726573756c7473",
      "resource-block_616c65727473",
      "resource-block_6f70657261746f72",
      "connection-652d646576696365732d696f74",
      "connection-652d696f742d627566666572",
      "connection-652d6275666665722d73636f726572",
      "connection-652d73636f7265722d71756172616e74696e65",
      "connection-652d73636f7265722d6d6f64656c",
      "connection-652d73636f7265722d726573756c7473",
      "connection-652d73636f7265722d616c65727473",
      "connection-652d616c657274732d6f70657261746f72"
    ]
  },
  "resource": {
    "terraform_data": {
      "review_gate": {
        "input": {
          "design_revision": 2,
          "environment": "staging"
        },
        "lifecycle": {
          "precondition": [
            {
              "condition": "${var.review_approved && length(local.unfinished_work) == 0}",
              "error_message": "Review this sketch and finish the work listed in resource-schedule.json before a deployment plan can succeed."
            }
          ]
        }
      }
    }
  },
  "output": {
    "design_revision": {
      "value": 2
    },
    "environment": {
      "value": "staging"
    },
    "implemented_foundations": {
      "value": 0
    },
    "buckets": {
      "value": {}
    }
  }
}
{
  "terraform": {
    "required_version": ">= 1.5.0, < 2.0.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 6.0"
      }
    }
  },
  "variable": {
    "aws_region": {
      "type": "string",
      "description": "Explicitly choose the reviewed deployment region; no region is assumed."
    },
    "aws_account_id": {
      "type": "string",
      "description": "Expected AWS account ID; provider refuses a different account.",
      "validation": {
        "condition": "${can(regex(\"^[0-9]{12}$\", var.aws_account_id))}",
        "error_message": "Use a twelve digit AWS account ID."
      }
    },
    "review_approved": {
      "type": "bool",
      "default": false,
      "description": "Set only after reviewing the design, cost, security and generated Terraform."
    }
  },
  "provider": {
    "aws": {
      "region": "${var.aws_region}",
      "allowed_account_ids": [
        "${var.aws_account_id}"
      ]
    }
  },
  "locals": {
    "unfinished_work": [
      "resource-block_64657669636573",
      "resource-block_696e67657374",
      "resource-block_76616c6964617465",
      "resource-block_71756172616e74696e65",
      "resource-block_696e666572656e6365",
      "resource-block_726573756c7473",
      "resource-block_616c657274",
      "resource-block_6f70657261746f72",
      "connection-652d6465762d696e67657374",
      "connection-652d696e676573742d76616c6964617465",
      "connection-652d76616c69646174652d71756172616e74696e65",
      "connection-652d76616c69646174652d696e666572",
      "connection-652d696e6665722d726573756c7473",
      "connection-652d726573756c74732d616c657274",
      "connection-652d616c6572742d6f70657261746f72"
    ]
  },
  "resource": {
    "terraform_data": {
      "review_gate": {
        "input": {
          "design_revision": 2,
          "environment": "staging"
        },
        "lifecycle": {
          "precondition": [
            {
              "condition": "${var.review_approved && length(local.unfinished_work) == 0}",
              "error_message": "Review this sketch and finish the work listed in resource-schedule.json before a deployment plan can succeed."
            }
          ]
        }
      }
    }
  },
  "output": {
    "design_revision": {
      "value": 2
    },
    "environment": {
      "value": "staging"
    },
    "implemented_foundations": {
      "value": 0
    },
    "buckets": {
      "value": {}
    }
  }
}
{
  "terraform": {
    "required_version": ">= 1.5.0, < 2.0.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 6.0"
      }
    }
  },
  "variable": {
    "aws_region": {
      "type": "string",
      "description": "Explicitly choose the reviewed deployment region; no region is assumed."
    },
    "aws_account_id": {
      "type": "string",
      "description": "Expected AWS account ID; provider refuses a different account.",
      "validation": {
        "condition": "${can(regex(\"^[0-9]{12}$\", var.aws_account_id))}",
        "error_message": "Use a twelve digit AWS account ID."
      }
    },
    "review_approved": {
      "type": "bool",
      "default": false,
      "description": "Set only after reviewing the design, cost, security and generated Terraform."
    }
  },
  "provider": {
    "aws": {
      "region": "${var.aws_region}",
      "allowed_account_ids": [
        "${var.aws_account_id}"
      ]
    }
  },
  "locals": {
    "unfinished_work": [
      "resource-block_7372632d73796e746865746963",
      "resource-block_6f74656c2d636f6c6c6563746f72",
      "resource-block_7075627375622d726177",
      "resource-block_696e676573742d776f726b6572",
      "resource-block_646c70",
      "resource-block_62712d74656c656d65747279",
      "resource-block_616e616c797369732d72756e74696d65",
      "resource-block_7665727465782d67656d696e69",
      "resource-block_696170",
      "resource-block_6f70657261746f72",
      "connection-652d7372632d6f74656c",
      "connection-652d6f74656c2d707562737562",
      "connection-652d7075627375622d776f726b6572",
      "connection-652d776f726b65722d646c70",
      "connection-652d776f726b65722d6271",
      "connection-652d62712d72756e74696d65",
      "connection-652d72756e74696d652d766572746578",
      "connection-652d6f70657261746f722d696170",
      "connection-652d6961702d72756e74696d65"
    ]
  },
  "resource": {
    "terraform_data": {
      "review_gate": {
        "input": {
          "design_revision": 2,
          "environment": "staging"
        },
        "lifecycle": {
          "precondition": [
            {
              "condition": "${var.review_approved && length(local.unfinished_work) == 0}",
              "error_message": "Review this sketch and finish the work listed in resource-schedule.json before a deployment plan can succeed."
            }
          ]
        }
      }
    }
  },
  "output": {
    "design_revision": {
      "value": 2
    },
    "environment": {
      "value": "staging"
    },
    "implemented_foundations": {
      "value": 0
    },
    "buckets": {
      "value": {}
    }
  }
}
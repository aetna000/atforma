    {
      "id": "ai-redact-before-store",
      "kind": "nonfunctional",
      "category": "security",
      "statement": "Proposed: sensitive fields are redacted from logs and trace attributes before they reach storage, search or the model.",
      "rationale": "If unredacted data reaches the index or prompts, secrets or personal data can leak into answers and long-lived storage.",
      "basis": "User asked to 'Include collection, redaction, storage/search'.",
      "priority": "must",
      "status": "open",
      "source": "agent",
      "links": [
        "redact",
        "firehose",
        "evidence",
        "search"
      ]
    },
    {
      "id": "ai-untrusted-log-text",
      "kind": "nonfunctional",
      "category": "security",
      "statement": "Proposed: log and trace content is passed to the model only as quoted evidence. Instructions found inside log text must never change the runtime's tools, scope or output policy.",
      "rationale": "Logs can contain attacker-controlled strings. Without this rule, they could inject prompts that mislead operators.",
      "basis": "User: 'Treat log text as untrusted.'",
      "priority": "must",
      "status": "open",
      "source": "agent",
      "links": [
        "analyzer",
        "guardrails",
        "bedrock"
      ]
    },
    {
      "id": "ai-cited-evidence",
      "kind": "functional",
      "category": "other",
      "statement": "Every incident explanation cites the trace IDs and log record IDs it relies on. It abstains when the evidence is insufficient.",
      "rationale": "Operators must be able to check the conclusion. An answer without evidence could send an incident response in the wrong direction.",
      "basis": "User: 'an operator-facing answer with source evidence'; REQ-001.",
      "priority": "must",
      "status": "open",
      "source": "agent",
      "links": [
        "analyzer",
        "api"
      ]
    }

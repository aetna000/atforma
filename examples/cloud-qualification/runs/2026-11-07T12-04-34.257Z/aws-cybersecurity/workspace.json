  "needs": [
    {
      "id": "ai-no-auto-action",
      "kind": "functional",
      "category": "security",
      "statement": "The system must only propose response actions; isolating hosts, disabling users or executing payloads requires a separate human-operated process outside this system.",
      "rationale": "Prevents an AI error or prompt injection in alert content from causing operational damage.",
      "basis": "User: \"Do not isolate hosts, disable users or execute payloads automatically.\"",
      "priority": "must",
      "status": "open",
      "source": "agent",
      "links": [

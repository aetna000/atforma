{
  "terraform": {
    "required_version": ">= 1.5.0, < 2.0.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 6.0"
      }
    }
  },
  "variable": {
    "aws_region": {
      "type": "string",
      "description": "Explicitly choose the reviewed deployment region; no region is assumed."
    },
    "aws_account_id": {
      "type": "string",
      "description": "Expected AWS account ID; provider refuses a different account.",
      "validation": {
        "condition": "${can(regex(\"^[0-9]{12}$\", var.aws_account_id))}",
        "error_message": "Use a twelve digit AWS account ID."
      }
    },
    "review_approved": {
      "type": "bool",
      "default": false,
      "description": "Set only after reviewing the design, cost, security and generated Terraform."
    }
  },
  "provider": {
    "aws": {
      "region": "${var.aws_region}",
      "allowed_account_ids": [
        "${var.aws_account_id}"
      ]
    }
  },
  "locals": {
    "unfinished_work": [
      "resource-block_7265706f",
      "resource-block_6170696777",
      "resource-block_7175657565",
      "resource-block_646c71",
      "resource-block_776f726b6572",
      "resource-block_73656372657473",
      "resource-block_6d6f64656c",
      "resource-block_647261667473",
      "resource-block_7265766965776572",
      "resource-block_6c6f6773",
      "connection-652d7265706f2d617069",
      "connection-652d6170692d7175657565",
      "connection-652d71756575652d776f726b6572",
      "connection-652d71756575652d646c71",
      "connection-652d7365637265742d776f726b6572",
      "connection-652d7265706f2d776f726b6572",
      "connection-652d776f726b65722d6d6f64656c",
      "connection-652d776f726b65722d647261667473",
      "connection-652d6472616674732d7265766965776572",
      "connection-652d776f726b65722d6c6f6773"
    ]
  },
  "resource": {
    "terraform_data": {
      "review_gate": {
        "input": {
          "design_revision": 2,
          "environment": "staging"
        },
        "lifecycle": {
          "precondition": [
            {
              "condition": "${var.review_approved && length(local.unfinished_work) == 0}",
              "error_message": "Review this sketch and finish the work listed in resource-schedule.json before a deployment plan can succeed."
            }
          ]
        }
      }
    }
  },
  "output": {
    "design_revision": {
      "value": 2
    },
    "environment": {
      "value": "staging"
    },
    "implemented_foundations": {
      "value": 0
    },
    "buckets": {
      "value": {}
    }
  }
}
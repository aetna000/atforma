  "requirements": [
    {
      "id": "ai-human-approval",
      "kind": "functional",
      "category": "security",
      "statement": "Predictions produce only operator-reviewed work-order drafts; the system never issues equipment control commands.",
      "rationale": "Prevents unsafe automated actions caused by false alarms.",
      "basis": "User: \"operator work-order draft. No automatic equipment control.\"",
      "priority": "must",
      "status": "open",
      "source": "agent",
      "links": [
        "workorder",
        "operator"
      ]
    },
    {
      "id": "ai-time-holdout",
      "kind": "nonfunctional",
      "category": "reliability",
      "statement": "Model versions are evaluated on a time-based held-out window before registry approval; acceptance thresholds to be agreed.",
      "rationale": "Random splits leak future data and overstate accuracy; mocks prove nothing about quality.",
      "basis": "User: \"held-out evaluation\", \"versioned prediction model\".",
      "priority": "must",
      "status": "open",
      "source": "agent",
      "links": [
        "train",
        "registry"
      ]
    },
    {
      "id": "ai-drift",
      "kind": "nonfunctional",
      "category": "maintainability",
      "statement": "Feature and prediction drift on scored data is monitored against the training baseline, with alerts to the model owner.",
      "rationale": "Sensor behaviour changes silently degrade predictions.",
      "basis": "User: \"drift monitoring\".",
      "priority": "should",
      "status": "open",
      "source": "agent",
      "links": [
        "monitor"
      ]
    }

{
  "terraform": {
    "required_version": ">= 1.5.0, < 2.0.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 6.0"
      }
    }
  },
  "variable": {
    "aws_region": {
      "type": "string",
      "description": "Explicitly choose the reviewed deployment region; no region is assumed."
    },
    "aws_account_id": {
      "type": "string",
      "description": "Expected AWS account ID; provider refuses a different account.",
      "validation": {
        "condition": "${can(regex(\"^[0-9]{12}$\", var.aws_account_id))}",
        "error_message": "Use a twelve digit AWS account ID."
      }
    },
    "review_approved": {
      "type": "bool",
      "default": false,
      "description": "Set only after reviewing the design, cost, security and generated Terraform."
    }
  },
  "provider": {
    "aws": {
      "region": "${var.aws_region}",
      "allowed_account_ids": [
        "${var.aws_account_id}"
      ]
    }
  },
  "locals": {
    "unfinished_work": [
      "resource-block_7374616666",
      "resource-block_656e747261",
      "resource-block_776562617070",
      "resource-block_6f7263686573747261746f72",
      "resource-block_7469636b657473",
      "resource-block_63726d",
      "resource-block_6b6e6f776c65646765",
      "resource-block_736561726368",
      "resource-block_6c6c6d",
      "resource-block_6775617264",
      "resource-block_657363616c6174696f6e",
      "resource-block_6d6f6e69746f72",
      "connection-652d73746166662d776562",
      "connection-652d7765622d656e747261",
      "connection-652d7765622d6f726368",
      "connection-652d7469636b6574732d6f726368",
      "connection-652d6f7263682d63726d",
      "connection-652d6b6e6f772d736561726368",
      "connection-652d6f7263682d736561726368",
      "connection-652d6f7263682d6c6c6d",
      "connection-652d6f7263682d6775617264",
      "connection-652d67756172642d657363",
      "connection-652d7765622d657363",
      "connection-652d6f7263682d6d6f6e"
    ]
  },
  "resource": {
    "terraform_data": {
      "review_gate": {
        "input": {
          "design_revision": 2,
          "environment": "staging"
        },
        "lifecycle": {
          "precondition": [
            {
              "condition": "${var.review_approved && length(local.unfinished_work) == 0}",
              "error_message": "Review this sketch and finish the work listed in resource-schedule.json before a deployment plan can succeed."
            }
          ]
        }
      }
    }
  },
  "output": {
    "design_revision": {
      "value": 2
    },
    "environment": {
      "value": "staging"
    },
    "implemented_foundations": {
      "value": 0
    },
    "buckets": {
      "value": {}
    }
  }
}
{
  "terraform": {
    "required_version": ">= 1.5.0, < 2.0.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 6.0"
      }
    }
  },
  "variable": {
    "aws_region": {
      "type": "string",
      "description": "Explicitly choose the reviewed deployment region; no region is assumed."
    },
    "aws_account_id": {
      "type": "string",
      "description": "Expected AWS account ID; provider refuses a different account.",
      "validation": {
        "condition": "${can(regex(\"^[0-9]{12}$\", var.aws_account_id))}",
        "error_message": "Use a twelve digit AWS account ID."
      }
    },
    "review_approved": {
      "type": "bool",
      "default": false,
      "description": "Set only after reviewing the design, cost, security and generated Terraform."
    }
  },
  "provider": {
    "aws": {
      "region": "${var.aws_region}",
      "allowed_account_ids": [
        "${var.aws_account_id}"
      ]
    }
  },
  "locals": {
    "unfinished_work": [
      "resource-block_63616c6c6572",
      "resource-block_616373",
      "resource-block_636f6e73656e74",
      "resource-block_737065656368",
      "resource-block_706969",
      "resource-block_6f7263686573747261746f72",
      "resource-block_736561726368",
      "resource-block_6c6c6d",
      "resource-block_6167656e74617070",
      "resource-block_656e747261",
      "resource-block_6167656e74",
      "resource-block_63726d",
      "resource-block_636f736d6f73",
      "resource-block_6d6f6e69746f72",
      "connection-652d63616c6c65722d616373",
      "connection-652d6163732d636f6e73656e74",
      "connection-652d636f6e73656e742d737065656368",
      "connection-652d636f6e73656e742d636f736d6f73",
      "connection-652d7370656563682d706969",
      "connection-652d7069692d6f726368",
      "connection-652d6f7263682d736561726368",
      "connection-652d6f7263682d6c6c6d",
      "connection-652d6f7263682d617070",
      "connection-652d656e7472612d617070",
      "connection-652d6170702d6167656e74",
      "connection-652d6170702d636f736d6f73",
      "connection-652d6167656e742d63726d",
      "connection-652d6f7263682d6d6f6e69746f72"
    ]
  },
  "resource": {
    "terraform_data": {
      "review_gate": {
        "input": {
          "design_revision": 2,
          "environment": "staging"
        },
        "lifecycle": {
          "precondition": [
            {
              "condition": "${var.review_approved && length(local.unfinished_work) == 0}",
              "error_message": "Review this sketch and finish the work listed in resource-schedule.json before a deployment plan can succeed."
            }
          ]
        }
      }
    }
  },
  "output": {
    "design_revision": {
      "value": 2
    },
    "environment": {
      "value": "staging"
    },
    "implemented_foundations": {
      "value": 0
    },
    "buckets": {
      "value": {}
    }
  }
}
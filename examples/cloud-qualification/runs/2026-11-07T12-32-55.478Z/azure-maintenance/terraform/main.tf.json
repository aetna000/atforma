{
  "terraform": {
    "required_version": ">= 1.5.0, < 2.0.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 6.0"
      }
    }
  },
  "variable": {
    "aws_region": {
      "type": "string",
      "description": "Explicitly choose the reviewed deployment region; no region is assumed."
    },
    "aws_account_id": {
      "type": "string",
      "description": "Expected AWS account ID; provider refuses a different account.",
      "validation": {
        "condition": "${can(regex(\"^[0-9]{12}$\", var.aws_account_id))}",
        "error_message": "Use a twelve digit AWS account ID."
      }
    },
    "review_approved": {
      "type": "bool",
      "default": false,
      "description": "Set only after reviewing the design, cost, security and generated Terraform."
    }
  },
  "provider": {
    "aws": {
      "region": "${var.aws_region}",
      "allowed_account_ids": [
        "${var.aws_account_id}"
      ]
    }
  },
  "locals": {
    "unfinished_work": [
      "resource-block_73656e736f722d686973746f7279",
      "resource-block_6d61696e74656e616e63652d686973746f7279",
      "resource-block_696e67657374696f6e",
      "resource-block_646174612d6c616b65",
      "resource-block_6d61696e74656e616e63652d6d6c",
      "resource-block_6d61696e74656e616e63652d617070",
      "resource-block_70726564696374696f6e2d6f7264657273",
      "resource-block_6f70657261746f72",
      "resource-block_6f7065726174696f6e732d6d6f6e69746f72",
      "connection-73656e736f72732d696e67657374",
      "connection-7265636f7264732d696e67657374",
      "connection-696e676573742d6c616b65",
      "connection-6c616b652d6d6c",
      "connection-6d6c2d6c616b65",
      "connection-6170702d6c616b65",
      "connection-6170702d6d6c",
      "connection-6d6c2d617070",
      "connection-6170702d6c6564676572",
      "connection-6c65646765722d617070",
      "connection-6f70657261746f722d617070",
      "connection-6170702d6f70657261746f72",
      "connection-6c65646765722d6d6c",
      "connection-696e676573742d6d6f6e69746f72",
      "connection-6d6c2d6d6f6e69746f72",
      "connection-6170702d6d6f6e69746f72",
      "connection-6d6f6e69746f722d6f70657261746f72"
    ]
  },
  "resource": {
    "terraform_data": {
      "review_gate": {
        "input": {
          "design_revision": 2,
          "environment": "staging"
        },
        "lifecycle": {
          "precondition": [
            {
              "condition": "${var.review_approved && length(local.unfinished_work) == 0}",
              "error_message": "Review this sketch and finish the work listed in resource-schedule.json before a deployment plan can succeed."
            }
          ]
        }
      }
    }
  },
  "output": {
    "design_revision": {
      "value": 2
    },
    "environment": {
      "value": "staging"
    },
    "implemented_foundations": {
      "value": 0
    },
    "buckets": {
      "value": {}
    }
  }
}
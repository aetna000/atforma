{
  "terraform": {
    "required_version": ">= 1.5.0, < 2.0.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 6.0"
      }
    }
  },
  "variable": {
    "aws_region": {
      "type": "string",
      "description": "Explicitly choose the reviewed deployment region; no region is assumed."
    },
    "aws_account_id": {
      "type": "string",
      "description": "Expected AWS account ID; provider refuses a different account.",
      "validation": {
        "condition": "${can(regex(\"^[0-9]{12}$\", var.aws_account_id))}",
        "error_message": "Use a twelve digit AWS account ID."
      }
    },
    "review_approved": {
      "type": "bool",
      "default": false,
      "description": "Set only after reviewing the design, cost, security and generated Terraform."
    }
  },
  "provider": {
    "aws": {
      "region": "${var.aws_region}",
      "allowed_account_ids": [
        "${var.aws_account_id}"
      ]
    }
  },
  "locals": {
    "unfinished_work": [
      "resource-block_63616c6c2d736f75726365",
      "resource-block_636f6e73656e742d67617465",
      "resource-block_617564696f2d696e67657374",
      "resource-block_737474",
      "resource-block_7069692d726564616374",
      "resource-block_6b6e6f776c65646765",
      "resource-block_6173736973742d6f7263686573747261746f72",
      "resource-block_67656d696e69",
      "resource-block_6167656e742d6465736b746f70",
      "resource-block_73756d6d6172792d73746f7265",
      "resource-block_63726d",
      "resource-block_6175646974",
      "connection-652d63616c6c2d636f6e73656e74",
      "connection-652d636f6e73656e742d696e67657374",
      "connection-652d696e676573742d737474",
      "connection-652d7374742d706969",
      "connection-652d7069692d6f726368",
      "connection-652d6f7263682d6b62",
      "connection-652d6f7263682d67656d696e69",
      "connection-652d6f7263682d6465736b",
      "connection-652d6465736b2d73746f7265",
      "connection-652d6465736b2d63726d",
      "connection-652d636f6e73656e742d6175646974",
      "connection-652d7069692d6175646974"
    ]
  },
  "resource": {
    "terraform_data": {
      "review_gate": {
        "input": {
          "design_revision": 2,
          "environment": "staging"
        },
        "lifecycle": {
          "precondition": [
            {
              "condition": "${var.review_approved && length(local.unfinished_work) == 0}",
              "error_message": "Review this sketch and finish the work listed in resource-schedule.json before a deployment plan can succeed."
            }
          ]
        }
      }
    }
  },
  "output": {
    "design_revision": {
      "value": 2
    },
    "environment": {
      "value": "staging"
    },
    "implemented_foundations": {
      "value": 0
    },
    "buckets": {
      "value": {}
    }
  }
}
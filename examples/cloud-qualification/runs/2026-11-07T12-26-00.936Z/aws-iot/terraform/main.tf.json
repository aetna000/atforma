  "resource": {
    "terraform_data": {
      "review_gate": {
        "input": {
          "design_revision": 2,
          "environment": "staging"
        },
        "lifecycle": {
          "precondition": [
            {
              "condition": "${var.review_approved && length(local.unfinished_work) == 0}",
              "error_message": "Review this sketch and finish the work listed in resource-schedule.json before a deployment plan can succeed."
            }
          ]
        }
      }
    },
    "aws_s3_bucket": {
      "block_6661696c7572652d73746f7265": {
        "bucket_prefix": "atforma-block-6661696c7572652d73-",
        "force_destroy": false,
        "lifecycle": {
          "prevent_destroy": true
        },
        "tags": {
          "ManagedBy": "AtMem AI Architect",
          "Environment": "staging"
        },
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "aws_s3_bucket_public_access_block": {
      "block_6661696c7572652d73746f7265": {
        "bucket": "${aws_s3_bucket.block_6661696c7572652d73746f7265.id}",
        "block_public_acls": true,
        "block_public_policy": true,
        "ignore_public_acls": true,
        "restrict_public_buckets": true,
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "aws_s3_bucket_server_side_encryption_configuration": {
      "block_6661696c7572652d73746f7265": {
        "bucket": "${aws_s3_bucket.block_6661696c7572652d73746f7265.id}",
        "rule": {
          "apply_server_side_encryption_by_default": {
            "sse_algorithm": "AES256"
          }
        },
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "aws_s3_bucket_versioning": {
      "block_6661696c7572652d73746f7265": {
        "bucket": "${aws_s3_bucket.block_6661696c7572652d73746f7265.id}",
        "versioning_configuration": {
          "status": "Enabled"
        },
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "aws_s3_bucket_ownership_controls": {
      "block_6661696c7572652d73746f7265": {
        "bucket": "${aws_s3_bucket.block_6661696c7572652d73746f7265.id}",
        "rule": {
          "object_ownership": "BucketOwnerEnforced"
        },
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "aws_s3_bucket_policy": {
      "block_6661696c7572652d73746f7265": {
        "bucket": "${aws_s3_bucket.block_6661696c7572652d73746f7265.id}",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"DenyInsecureTransport\",\"Effect\":\"Deny\",\"Principal\":\"*\",\"Action\":\"s3:*\",\"Resource\":[\"${aws_s3_bucket.block_6661696c7572652d73746f7265.arn}\",\"${aws_s3_bucket.block_6661696c7572652d73746f7265.arn}/*\"],\"Condition\":{\"Bool\":{\"aws:SecureTransport\":\"false\",\"aws:PrincipalIsAWSService\":\"false\"}}}]}",
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    }
  },
  "output": {

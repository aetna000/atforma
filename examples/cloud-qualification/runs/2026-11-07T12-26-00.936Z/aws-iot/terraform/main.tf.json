      "connection-652d696e676573742d6661696c757265",
      "connection-652d6275666665722d776f726b6572",
      "connection-652d776f726b65722d7265676973747279",
      "connection-652d776f726b65722d6d6f64656c",
      "connection-652d6d6f64656c2d776f726b6572",
      "connection-652d776f726b65722d726573756c7473",
      "connection-652d776f726b65722d6661696c757265",
      "connection-652d726573756c74732d6469737061746368",
      "connection-652d64697370617463682d746f706963",
      "connection-652d64697370617463682d6661696c757265",
      "connection-652d746f7069632d6f70657261746f72",

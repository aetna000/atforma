  "requirements": [
    {
      "id": "ai-consent-before-capture",
      "kind": "functional",
      "category": "compliance",
      "statement": "No call audio is captured, transcribed or stored until the caller's consent is recorded; missing or declined consent fails closed.",
      "rationale": "Recording without consent creates legal exposure; fail-closed gate is testable.",
      "basis": "User: \"Include consent, audio ingestion...\"",
      "priority": "must",
      "status": "open",
      "source": "agent",
      "links": [
